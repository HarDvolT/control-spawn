<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>Control Spawn</Product>
    <!-- Task Manager shows FileDescription (AssemblyTitle) and CompanyName; without these .NET falls back to the assembly name. -->
    <Company>Control Spawn</Company>
    <Version>1.0.4</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ControlSpawn.Core' Or '$(MSBuildProjectName)' == 'ControlSpawn.Hardware' Or '$(MSBuildProjectName)' == 'ControlSpawn.Lighting' Or '$(MSBuildProjectName)' == 'ControlSpawn.Router' Or '$(MSBuildProjectName)' == 'ControlSpawn.Service' Or '$(MSBuildProjectName)' == 'ControlSpawn.FanGuard'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
  </PropertyGroup>
  <!-- These DLLs ship in the install folder. The projects and namespaces keep the code name. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ControlSpawn.Core' Or '$(MSBuildProjectName)' == 'ControlSpawn.Hardware' Or '$(MSBuildProjectName)' == 'ControlSpawn.Lighting' Or '$(MSBuildProjectName)' == 'ControlSpawn.Router'">
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ControlSpawn.Service' Or '$(MSBuildProjectName)' == 'ControlSpawn.FanGuard'">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
