<Project Sdk="Microsoft.NET.Sdk">
  <!-- A child process the service starts before any fan write; never a Windows service. If the service dies, hangs or
       stops beating, it hands the fans back to the BIOS. Ships in service\ beside ControlSpawn.Service.exe. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ControlSpawn.FanGuard</AssemblyName>
    <AssemblyTitle>Control Spawn Fan Guard</AssemblyTitle>
    <RootNamespace>Prism.FanGuard</RootNamespace>
    <ApplicationIcon>..\Prism.App\Assets\ControlSpawn.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same shared framework as the service: both publish into service\, where every common file must match byte for byte. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Prism.Hardware/Prism.Hardware.csproj" />
    <!-- Same log files as the service (ProgramData\Prism\logs). -->
    <Compile Include="../Prism.Service/RollingLogProvider.cs" Link="RollingLogProvider.cs" />
  </ItemGroup>
</Project>
