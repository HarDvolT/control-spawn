<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The WPF entry point uses the per-monitor-v2 manifest; WinForms only hosts NotifyIcon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>Prism.App</AssemblyName>
    <RootNamespace>Prism.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prism.Core\Prism.Core.csproj" />
    <ProjectReference Include="..\Prism.Lighting\Prism.Lighting.csproj" />
  </ItemGroup>

  <ItemGroup><Resource Include="Assets\Fonts\*.ttf" /></ItemGroup>

  <!-- The WinForms SDK adds global usings that make Application/Color/Timer ambiguous with WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
