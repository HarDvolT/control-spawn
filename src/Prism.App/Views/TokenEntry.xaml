<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Prism.App.Views.TokenEntry">
  <StackPanel>
    <TextBlock x:Name="HostLabel" Text="Lamp host" Margin="0,8"/>
    <TextBox Background="#252529" BorderBrush="#3F3F46" BorderThickness="1" Padding="10" x:Name="Host" Text="192.168.0.10" AutomationProperties.Name="Lamp host"/>
    <PasswordBox x:Name="Secret" AutomationProperties.Name="Credential" Background="#252529" Foreground="#F4F4F5" Padding="10" Margin="0,10"/>
    <Button x:Name="SaveButton" Content="Save" Click="Save" HorizontalAlignment="Left"/>
    <TextBlock x:Name="Result" TextWrapping="Wrap" Margin="0,8"/>
  </StackPanel>
</UserControl>
