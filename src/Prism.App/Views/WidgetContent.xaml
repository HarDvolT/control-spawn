<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Prism.App.Controls" x:Class="Prism.App.Views.WidgetContent" Foreground="#F4F4F5">
  <Viewbox Stretch="Uniform">
    <Border Width="250" CornerRadius="18" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="16">
      <Border.Background>
        <SolidColorBrush Color="#18181B" Opacity="{Binding Opacity}"/>
      </Border.Background>
      <StackPanel>
        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" MouseLeftButtonDown="DragHeader" Cursor="SizeAll"/>
        <StackPanel Visibility="{Binding ShowsMetrics, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}"/>
              <TextBlock Text="CPU"/>
            </DockPanel>
            <c:GlowProgressBar Height="16" Value="{Binding CpuPercent}" ShowLabel="False" Margin="0,5"/>
          </StackPanel>
          <StackPanel Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding GpuText}"/>
              <TextBlock Text="GPU"/>
            </DockPanel>
            <c:GlowProgressBar Height="16" Value="{Binding GpuPercent}" ShowLabel="False" Margin="0,5"/>
          </StackPanel>
          <WrapPanel Visibility="{Binding ShowTemps, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="CPU "/>
            <TextBlock Text="{Binding CpuTempText}"/>
            <TextBlock Text="  GPU "/>
            <TextBlock Text="{Binding GpuTempText}"/>
          </WrapPanel>
          <TextBlock Visibility="{Binding ShowRam, Converter={StaticResource BoolToVisibility}}" Text="{Binding RamText}" Margin="0,5"/>
          <StackPanel Visibility="{Binding ShowNet, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding DownText, StringFormat=↓ {0}}"/>
            <TextBlock Text="{Binding UpText, StringFormat=↑ {0}}"/>
            <c:LineChart Values="{Binding NetDownHistory}" SecondaryValues="{Binding NetUpHistory}" Height="42"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsCpu, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding CpuClockText}" Margin="0,5"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsGpu, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding GpuClockText}" Margin="0,5"/>
          <TextBlock Text="{Binding VramText, StringFormat=VRAM {0}}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsFans, Converter={StaticResource BoolToVisibility}}">
          <c:SegmentedControl ItemsSource="{Binding FanModes}" SelectedItem="{Binding FanMode, Mode=TwoWay}">
            <c:SegmentedControl.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentItemStyle}">
                <Setter Property="FontSize" Value="10"/>
              </Style>
            </c:SegmentedControl.ItemContainerStyle>
          </c:SegmentedControl>
          <ItemsControl ItemsSource="{Binding FanRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,5">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding RpmText}"/>
                  <TextBlock Text="{Binding Name}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Visibility="{Binding IsLighting, Converter={StaticResource BoolToVisibility}}">
          <ComboBox ItemsSource="{Binding EffectNames}" SelectedItem="{Binding SelectedEffectName, Mode=TwoWay}"/>
          <c:LedStrip Height="28" Margin="0,8" ColorHex="{Binding LightingColor}" EffectKind="{Binding LightingEffectKind}" Brightness="{Binding Brightness}" Speed="{Binding Speed}"/>
          <ItemsControl ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="24" Height="24" Margin="3" Background="{Binding Converter={StaticResource HexToBrush}}" Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Visibility="{Binding IsLamp, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding LampOn, Mode=TwoWay}"/>
            <TextBlock Text="{Binding LampSubtitle}"/>
          </DockPanel>
          <DockPanel Margin="0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding LampBrightness, Converter={StaticResource Percent}}"/>
            <c:ThickSlider Minimum="1" Value="{Binding LampBrightness, Mode=TwoWay}"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding IsModem, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding ModemNetwork}"/>
          <TextBlock Text="{Binding ModemVerdict}" Style="{StaticResource Number}" Foreground="{Binding ModemColor, Converter={StaticResource HexToBrush}}"/>
          <ItemsControl ItemsSource="{Binding ModemBars}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="7" Height="{Binding Height}" Margin="2" VerticalAlignment="Bottom" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding ModemRsrp, StringFormat=RSRP {0}}"/>
          <TextBlock Text="{Binding ModemSinr, StringFormat=SINR {0}}"/>
          <TextBlock Text="{Binding PingText, StringFormat=Ping {0} ms}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsPing, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding PingText, StringFormat={}{0} ms}" Style="{StaticResource NumberLarge}"/>
          <c:LineChart Values="{Binding PingHistory}" Height="65" AutoScale="True"/>
        </StackPanel>
        <ItemsControl Visibility="{Binding IsScenes, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding Scenes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Name}" Margin="3" Padding="8" Style="{StaticResource BaseButton}" Command="{Binding DataContext.ApplySceneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" Foreground="#FF8A8A" FontSize="11"/>
      </StackPanel>
    </Border>
  </Viewbox>
</UserControl>
