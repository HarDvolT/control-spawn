<ResourceDictionary xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:v="clr-namespace:Prism.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate DataType="{x:Type vm:LampViewModel}">
    <DataTemplate.Resources>
      <Style x:Key="LampFollowItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" CornerRadius="10" Padding="10,12" Margin="2" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#1E2026"/><Setter TargetName="Tile" Property="BorderBrush" Value="#FF4D1A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
      <Style x:Key="LampListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="#18181B" />
        <Setter Property="Foreground" Value="#F4F4F5" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="Padding" Value="6" />
      </Style>
      <Style x:Key="LampListItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" Padding="8" Margin="0,2" CornerRadius="6" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#252529" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#3D2823" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </DataTemplate.Resources>
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
          <Button Content="Add or fix a lamp" Command="{Binding ShowSetupCommand}" Style="{StaticResource PillButton}" Margin="0,4,8,4" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="LAMPS" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <c:GlassCard Margin="0,0,0,16" Padding="18,16" Visibility="{Binding ShowSharedBar, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <c:SegmentedControl DockPanel.Dock="Right" ItemsSource="{Binding SharedFollowModes}" SelectedItem="{Binding SharedFollowLabel, Mode=TwoWay}" VerticalAlignment="Center"/>
          <ItemsControl DockPanel.Dock="Left" Width="62" ItemsSource="{Binding SharedLampRows}" Margin="0,0,14,0" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:LampOrb Width="36" Height="36" RadiusInset="0" GlowRadius="12" ColorHex="{Binding Color}" Margin="0,0,-10,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <StackPanel DockPanel.Dock="Left" Margin="0,0,18,0" VerticalAlignment="Center"><TextBlock Text="Both lamps" Style="{StaticResource CardTitle}"/><TextBlock Text="One tap changes both" Style="{StaticResource SmallMuted}" Margin="0,2,0,0"/></StackPanel>
          <Button DockPanel.Dock="Left" Content="{Binding ToggleBothText}" Command="{Binding ToggleBothCommand}" Style="{StaticResource PillButton}" Margin="0,0,18,0"/>
          <ItemsControl ItemsSource="{Binding SharedSwatches}" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:ColorSwatch Width="30" Height="30" Margin="0,0,8,0" ColorHex="{Binding}" SelectedHex="{Binding DataContext.SharedColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.BothColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </DockPanel>
      </c:GlassCard>
      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:SpacedGrid Columns="2" Gap="16" FitToCount="True"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <c:GlassCard Padding="18" Margin="0,0,0,16" MinHeight="466">
              <StackPanel>
                <DockPanel>
                  <c:StatusChip DockPanel.Dock="Right" Text="{Binding ConnectionText}" Level="Ok"/>
                  <StackPanel>
                    <c:DeviceNameEditor DeviceId="{Binding Id}" DisplayName="{Binding Name}" Client="{Binding Client}" FontSize="20" FontWeight="SemiBold" />

                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,8,0,8">
                  <Button Command="{Binding ToggleCommand}" Style="{StaticResource TextAction}" HorizontalAlignment="Left" Margin="0,0,16,0">
                    <Grid Width="174" Height="174"><c:LampOrb ColorHex="{Binding ColorEntry}"/><TextBlock Text="{Binding PowerText}" Foreground="#AA07080A" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
                  </Button>
                  <StackPanel Margin="0,8">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Brightness, StringFormat={}{0:0}%}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Brightness" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/></DockPanel>
                    <c:ThickSlider UseGradient="True" Glow="False" AccentColor="{Binding ColorEntry, Converter={StaticResource HexToColor}}" Minimum="1" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}" AutomationProperties.Name="Brightness" Margin="0,8,0,0" />

                    <UniformGrid Columns="4" Margin="0,12,0,0">
                      <c:ChoiceButton Choice="10" Selection="{Binding Brightness}" Content="10%" Command="{Binding SetBrightnessCommand}" CommandParameter="10" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                      <c:ChoiceButton Choice="45" Selection="{Binding Brightness}" Content="45%" Command="{Binding SetBrightnessCommand}" CommandParameter="45" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                      <c:ChoiceButton Choice="70" Selection="{Binding Brightness}" Content="70%" Command="{Binding SetBrightnessCommand}" CommandParameter="70" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                      <c:ChoiceButton Choice="100" Selection="{Binding Brightness}" Content="Max" Command="{Binding SetBrightnessCommand}" CommandParameter="100" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                    </UniformGrid>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,10"><Button x:Name="CustomColorButton" DockPanel.Dock="Right" Content="Custom" Command="{Binding OpenCustomColorCommand}" Style="{StaticResource TextAction}" Height="16" MinHeight="0" Padding="0"/><TextBlock Text="COLOUR" Style="{StaticResource SectionLabel}"/></DockPanel><Popup IsOpen="{Binding CustomColorOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=CustomColorButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="#17181D" CornerRadius="16" Padding="16" BorderBrush="#33FFFFFF" BorderThickness="1"><StackPanel><c:ColorWheel ColorHex="{Binding ColorEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="160"/><Button Content="Follow lighting map" Command="{Binding FollowMapCommand}" Margin="0,12,0,0"/></StackPanel></Border></Popup><ItemsControl ItemsSource="{Binding Swatches}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <c:ColorSwatch ColorHex="{Binding}" SelectedHex="{Binding DataContext.ColorEntry, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Height="34" MinHeight="34" Margin="0,0,6,12" Padding="0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <UniformGrid Columns="3" Margin="0,0,0,14"><Button Content="Warm white" Command="{Binding SelectColorCommand}" CommandParameter="#FFD5A8" MinHeight="34" Margin="0,0,8,0"/><Button Content="Neutral" Command="{Binding SelectColorCommand}" CommandParameter="#FFF1DF" MinHeight="34" Margin="0,0,8,0"/><Button Content="Cool white" Command="{Binding SelectColorCommand}" CommandParameter="#DCEEFF" MinHeight="34"/></UniformGrid>
                <TextBlock Text="FOLLOWS" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" />
                <c:SegmentedControl ItemsSource="{Binding PrimaryFollowModes}" SelectedItem="{Binding Follow, Mode=TwoWay}" ItemContainerStyle="{StaticResource LampFollowItem}" Margin="0,8,0,0" FontSize="11">
                  <c:SegmentedControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel><TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Own"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="pc"><Setter Property="Text" Value="Same as PC"/></DataTrigger><DataTrigger Binding="{Binding}" Value="average"><Setter Property="Text" Value="Average"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#7C808A" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="its own colour"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="pc"><Setter Property="Text" Value="matches the case"/></DataTrigger><DataTrigger Binding="{Binding}" Value="average"><Setter Property="Text" Value="soft PC average"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                    </DataTemplate>
                  </c:SegmentedControl.ItemTemplate>
                </c:SegmentedControl>
                <TextBlock Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Text="{Binding LastError}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Foreground="#FF8A8A" />

              </StackPanel>
            </c:GlassCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:CardGrid>
        <c:GlassCard Span="6" MinHeight="202">
          <StackPanel>
            <TextBlock Text="Moods" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="No saved moods available" Style="{StaticResource SmallMuted}" Margin="0,0,0,12"/>
            <c:SpacedGrid Columns="5" Gap="8"><Border Background="#17181D" CornerRadius="14" Height="76"><TextBlock Text="&#x2014;" Foreground="#7C808A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Background="#17181D" CornerRadius="14" Height="76"/><Border Background="#17181D" CornerRadius="14" Height="76"/><Border Background="#17181D" CornerRadius="14" Height="76"/><Border Background="#17181D" CornerRadius="14" Height="76"/></c:SpacedGrid>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="6" MinHeight="202">
          <StackPanel>
            <TextBlock Text="Schedule" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="No schedule data available" Style="{StaticResource SmallMuted}" Margin="0,0,0,12"/>
            <StackPanel>
              <DockPanel Height="40"><c:ToggleSwitch DockPanel.Dock="Right" IsEnabled="False" ToolTip="Schedule unavailable"/><TextBlock DockPanel.Dock="Left" Width="64" Text="&#x2014;" FontSize="16" VerticalAlignment="Center" Foreground="#7C808A"/><Border Background="#1E2026" Height="8" CornerRadius="4" Margin="0,0,32,0" VerticalAlignment="Center"/></DockPanel>
              <DockPanel Height="40"><c:ToggleSwitch DockPanel.Dock="Right" IsEnabled="False" ToolTip="Schedule unavailable"/><TextBlock DockPanel.Dock="Left" Width="64" Text="&#x2014;" FontSize="16" VerticalAlignment="Center" Foreground="#7C808A"/><Border Background="#1E2026" Height="8" CornerRadius="4" Margin="0,0,32,0" VerticalAlignment="Center"/></DockPanel>
              <DockPanel Height="40"><c:ToggleSwitch DockPanel.Dock="Right" IsEnabled="False" ToolTip="Schedule unavailable"/><TextBlock DockPanel.Dock="Left" Width="64" Text="&#x2014;" FontSize="16" VerticalAlignment="Center" Foreground="#7C808A"/><Border Background="#1E2026" Height="8" CornerRadius="4" Margin="0,0,32,0" VerticalAlignment="Center"/></DockPanel>
            </StackPanel>
          </StackPanel>
        </c:GlassCard>
      </c:CardGrid>
      <Expander IsExpanded="{Binding IsSetupOpen, Mode=TwoWay}" Visibility="{Binding IsSetupOpen, Converter={StaticResource BoolToVisibility}}" Header="Add or fix a lamp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16">
        <StackPanel>
          <Button Content="Find lamps" Command="{Binding FindCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />
          <ListBox Style="{StaticResource LampListStyle}" ItemContainerStyle="{StaticResource LampListItemStyle}" ItemsSource="{Binding Discovered}" SelectedItem="{Binding SelectedFound}" DisplayMemberPath="Label" MaxHeight="150" />
          <ListBox Style="{StaticResource LampListStyle}" ItemContainerStyle="{StaticResource LampListItemStyle}" ItemsSource="{Binding Lamps}" SelectedItem="{Binding SelectedLamp}" Margin="0,12" MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="4,8">
                  <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Name}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Connected, Converter={StaticResource FriendlyLabel}}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Transport, Converter={StaticResource FriendlyLabel}}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Host}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <c:DeviceNameEditor DeviceId="{Binding SelectedLamp.Id}" DisplayName="{Binding SelectedLamp.Name}" Client="{Binding Client}" />
          <StackPanel Orientation="Horizontal" Margin="0,8">
            <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="12,0" />
          </StackPanel>
          <TextBlock Text="{Binding Host}" />
          <TextBlock Text="{Binding LampError}" Foreground="#FF8A8A" />
          <ComboBox ItemsSource="{Binding FollowModes}" SelectedItem="{Binding SelectedFollow}" Margin="0,8">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource FriendlyLabel}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12" />
          <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
            <StackPanel>
              <TextBlock Text="Add token for selected device" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
              <v:TokenEntry />
              <TextBlock Text="{Binding TokenNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
            </StackPanel>
          </c:GlassCard>
        </StackPanel>
      </Expander>
      <TextBlock Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>