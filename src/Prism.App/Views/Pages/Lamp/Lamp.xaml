<ResourceDictionary xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:v="clr-namespace:Prism.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate DataType="{x:Type vm:LampViewModel}">
    <DataTemplate.Resources>
      <Style x:Key="LampListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="#18181B" />
        <Setter Property="Foreground" Value="#F4F4F5" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="Padding" Value="6" />
      </Style>
      <Style x:Key="LampListItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" Padding="8" Margin="0,2" CornerRadius="6" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#252529" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#3D2823" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </DataTemplate.Resources>
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
          <Button Content="Find lamps" Command="{Binding FindCommand}" Style="{StaticResource PillButton}" Margin="0,4,8,4" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="LAMPS" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <c:GlassCard Span="12" Margin="0,0,0,16" Padding="18,12">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="Both lamps" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" DockPanel.Dock="Left" VerticalAlignment="Center" Width="120" />
            <WrapPanel DockPanel.Dock="Right">
              <Button Content="All on" Command="{Binding SetBothCommand}" CommandParameter="on" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" />
              <Button Content="All off" Command="{Binding SetBothCommand}" CommandParameter="off" Style="{StaticResource PillButton}" Margin="0,4,8,4" />
            </WrapPanel>
            <StackPanel Margin="0,8">
              <TextBlock Text="Brightness" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" />
              <c:ThickSlider Minimum="1" Maximum="100" Value="{Binding BothBrightness, Mode=TwoWay}" AutomationProperties.Name="Brightness" Margin="0,8,0,0" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </c:GlassCard>
      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <c:GlassCard Padding="18" Margin="0,0,16,16" MinHeight="466">
              <StackPanel>
                <DockPanel>
                  <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding On, Mode=TwoWay}" AutomationProperties.Name="Lamp power" />
                  <StackPanel>
                    <c:DeviceNameEditor DeviceId="{Binding Id}" DisplayName="{Binding Name}" Client="{Binding Client}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,6" />
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,8,0,8">
                  <Button Command="{Binding ToggleCommand}" Style="{StaticResource TextAction}" HorizontalAlignment="Left" Margin="0,0,16,0">
                    <c:LampOrb Width="165" Height="165" ColorHex="{Binding ColorEntry}" />
                  </Button>
                  <StackPanel Margin="0,8">
                    <TextBlock Text="Brightness" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" />
                    <c:ThickSlider Minimum="1" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}" AutomationProperties.Name="Brightness" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Brightness, StringFormat={}{0:0}%}" Style="{StaticResource Number}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                    <UniformGrid Columns="4" Margin="0,12,0,0">
                      <Button Content="10%" Command="{Binding SetBrightnessCommand}" CommandParameter="10" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                      <Button Content="45%" Command="{Binding SetBrightnessCommand}" CommandParameter="45" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                      <Button Content="70%" Command="{Binding SetBrightnessCommand}" CommandParameter="70" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                      <Button Content="Max" Command="{Binding SetBrightnessCommand}" CommandParameter="100" MinHeight="32" Padding="4,0" Margin="0,0,5,0" />
                    </UniformGrid>
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Swatches}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Background="{Binding Converter={StaticResource HexToBrush}}" Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Height="28" MinHeight="28" Margin="0,0,6,12" Padding="0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Follow" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" />
                <c:SegmentedControl ItemsSource="{Binding FollowModes}" SelectedItem="{Binding Follow, Mode=TwoWay}" Margin="0,10" FontSize="11">
                  <c:SegmentedControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource FriendlyLabel}}" />
                    </DataTemplate>
                  </c:SegmentedControl.ItemTemplate>
                </c:SegmentedControl>
                <TextBlock Text="{Binding LastError}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Foreground="#FF8A8A" />
                <Expander Header="Custom colour" Foreground="{StaticResource TextSecondaryBrush}">
                  <c:ColorWheel ColorHex="{Binding ColorEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="160" HorizontalAlignment="Center" Margin="0,12" />
                </Expander>
              </StackPanel>
            </c:GlassCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:CardGrid>
        <c:GlassCard Span="6" MinHeight="180">
          <StackPanel>
            <TextBlock Text="Moods" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="Unavailable · Saved lamp moods are not supplied by the service." Style="{StaticResource Placeholder}" TextWrapping="Wrap" />
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="6" MinHeight="180">
          <StackPanel>
            <TextBlock Text="Schedule" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="Unavailable · Service schedules are not available yet." Style="{StaticResource Placeholder}" TextWrapping="Wrap" />
          </StackPanel>
        </c:GlassCard>
      </c:CardGrid>
      <Expander Header="Add or fix a lamp" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16">
        <StackPanel>
          <Button Content="Find lamps" Command="{Binding FindCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" />
          <ListBox Style="{StaticResource LampListStyle}" ItemContainerStyle="{StaticResource LampListItemStyle}" ItemsSource="{Binding Discovered}" SelectedItem="{Binding SelectedFound}" DisplayMemberPath="Label" MaxHeight="150" />
          <ListBox Style="{StaticResource LampListStyle}" ItemContainerStyle="{StaticResource LampListItemStyle}" ItemsSource="{Binding Lamps}" SelectedItem="{Binding SelectedLamp}" Margin="0,12" MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="4,8">
                  <Ellipse Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Name}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Connected, Converter={StaticResource FriendlyLabel}}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Transport, Converter={StaticResource FriendlyLabel}}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding Host}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <c:DeviceNameEditor DeviceId="{Binding SelectedLamp.Id}" DisplayName="{Binding SelectedLamp.Name}" Client="{Binding Client}" />
          <StackPanel Orientation="Horizontal" Margin="0,8">
            <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="12,0" />
          </StackPanel>
          <TextBlock Text="{Binding Host}" />
          <TextBlock Text="{Binding LampError}" Foreground="#FF8A8A" />
          <ComboBox ItemsSource="{Binding FollowModes}" SelectedItem="{Binding SelectedFollow}" Margin="0,8">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource FriendlyLabel}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12" />
          <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
            <StackPanel>
              <TextBlock Text="Add token for selected device" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
              <v:TokenEntry />
              <TextBlock Text="{Binding TokenNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
            </StackPanel>
          </c:GlassCard>
        </StackPanel>
      </Expander>
      <TextBlock Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>