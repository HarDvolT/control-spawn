<ResourceDictionary xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate DataType="{x:Type vm:FansViewModel}">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
          <c:SegmentedControl ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedModeName, Mode=TwoWay}" Margin="0,4,0,12" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="FANS" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" TextWrapping="Wrap" />
          <TextBlock Text="Barely audible · pump locked at 100% · BIOS hand-back armed" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <ItemsControl ItemsSource="{Binding Fans}" Margin="0,0,0,16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:SpacedGrid Columns="3" Gap="16"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.SelectFanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0" Padding="18" Height="254" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource PanelGradientBrush}" CornerRadius="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                          </Trigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource PanelAltBrush}" />
                            <Setter TargetName="Card" Property="Effect">
                              <Setter.Value>
                                <DropShadowEffect Color="#FF4D1A" BlurRadius="24" ShadowDepth="0" Opacity="0.2" />
                              </Setter.Value>
                            </Setter>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="1">
                    <c:DeviceNameEditor DeviceId="{Binding Id}" DisplayName="{Binding Name}" Client="{Binding DataContext.Client, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,4,6,0" />
                  </StackPanel>
                </Grid>
                <DockPanel Margin="0,8,0,6">
                  <Grid DockPanel.Dock="Left" Width="92" Height="92" Margin="0,0,12,0">
                    <c:RingGauge Value="{Binding Percent}" ShowValue="False" SweepAngle="270" RingColor="#36D6FF" />
                    <c:FanRotor SpinSeconds="{Binding SpinSeconds}" Margin="0" Width="40" Height="40">
                      <c:FanRotor.Style>
                        <Style TargetType="c:FanRotor">
                          <Setter Property="Color" Value="#A1A1AA" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter Property="Color" Value="#FF4D1A" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </c:FanRotor.Style>
                    </c:FanRotor>
                  </Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RpmText}" Style="{StaticResource Number}" VerticalAlignment="Center" ToolTip="Live RPM" FontSize="32" />
                    <TextBlock Text="{Binding Percent, StringFormat={}{0:0}% duty}" Style="{StaticResource SmallMuted}" Foreground="#36D6FF" Margin="0,6" />
                  </StackPanel>
                </DockPanel>
                <c:SpacedGrid Columns="3" Gap="8" Margin="0,10,0,0"><Border Background="#17181D" CornerRadius="12" Padding="12,10"><StackPanel><TextBlock Text="Min sampled" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding MinimumText}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#17181D" CornerRadius="12" Padding="12,10"><StackPanel><TextBlock Text="Max sampled" Style="{StaticResource SmallMuted}"/><TextBlock Text="{Binding MaximumText}" FontSize="17" FontWeight="SemiBold"/></StackPanel></Border><Border Background="#17181D" CornerRadius="12" Padding="12,10"><StackPanel><TextBlock Text="Fans" Style="{StaticResource SmallMuted}"/><TextBlock Text="&#x2014;" FontSize="17"/></StackPanel></Border></c:SpacedGrid>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <c:CardGrid>
        <c:GlassCard StaggerIndex="0" Span="8">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <ComboBox IsEnabled="{Binding IsPumpSelected, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Follows temperature" ItemsSource="{Binding Sources}" SelectedItem="{Binding SourceName}" Margin="0" MinHeight="32" Width="180" DockPanel.Dock="Right" />
              <TextBlock Text="Fan curve" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <c:FanCurveEditor Height="260" SelectedIndex="{Binding SelectedCurvePoint, Mode=TwoWay}" Points="{Binding Curve}" NowTemperature="{Binding NowTemp}" NowPercent="{Binding NowPercent}" IsEnabled="{Binding IsPumpSelected, Converter={StaticResource InverseBool}}" />
            <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding IsPumpSelected, Converter={StaticResource InverseBool}}"><TextBlock Text="{Binding PointLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="&#x2212; 5% speed" Command="{Binding NudgePointCommand}" CommandParameter="down" Margin="0,0,6,0"/><Button Content="+ 5% speed" Command="{Binding NudgePointCommand}" CommandParameter="up" Margin="0,0,6,0"/><Button Content="&#x2190; 5&#x00B0; cooler" Command="{Binding NudgePointCommand}" CommandParameter="cooler" Margin="0,0,6,0"/><Button Content="5&#x00B0; hotter &#x2192;" Command="{Binding NudgePointCommand}" CommandParameter="hotter"/></WrapPanel>
            <Expander Header="Minimum speed" Foreground="#A3A6AE" Margin="0,12,0,0">
            <StackPanel Margin="0,8">
              <TextBlock Text="Minimum speed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding MinSpeedText}" TextAlignment="Right" />
                <c:ThickSlider IsEnabled="{Binding IsPumpSelected, Converter={StaticResource InverseBool}}" Minimum="0" Maximum="100" Value="{Binding MinSpeed, Mode=TwoWay}" AutomationProperties.Name="Minimum speed" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>
            </Expander>

            <Button IsEnabled="{Binding IsPumpSelected, Converter={StaticResource InverseBool}}" Content="Apply curve" Style="{StaticResource TextAction}" HorizontalAlignment="Right" Margin="0,0,0,0" Command="{Binding ApplyCurveCommand}" />
            <TextBlock Text="{Binding MeasureText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </StackPanel>
        </c:GlassCard>
        <StackPanel c:CardGrid.Span="4">
          <c:GlassCard Span="4">
            <StackPanel>
              <TextBlock Text="Safety" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <c:StatusChip Text="Pump locked at 100%" Margin="0,0,0,12" />
              <TextBlock Text="Pump always runs at full speed." Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBlock Text="BIOS hand-back" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,14,0,4" />
              <TextBlock Text="{Binding SafetyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBlock Text="If Prism stops responding, control returns to the BIOS." Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,8" />
            </StackPanel>
          </c:GlassCard>
          <Border Height="16" />
          <c:GlassCard Span="4">
            <StackPanel>
              <TextBlock Text="Smoothing" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Ramp-up and hysteresis are managed by the service." Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBlock Text="Unavailable · Smoothing controls are not exposed by the service." Style="{StaticResource Placeholder}" TextWrapping="Wrap" />
            </StackPanel>
          </c:GlassCard>
        </StackPanel>
        <c:GlassCard Span="12">
          <StackPanel>
            <TextBlock Text="Fan headers" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding HeaderRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#17181D" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Sub}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" />
                      <c:DeviceNameEditor DeviceId="{Binding Id}" DisplayName="{Binding Name}" Client="{Binding DataContext.Client, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                      <TextBlock Text="{Binding RpmText}" Style="{StaticResource Number}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
      </c:CardGrid>
      <TextBlock Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>