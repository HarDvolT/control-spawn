<ResourceDictionary xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:v="clr-namespace:Prism.App.Views">
  <DataTemplate DataType="{x:Type vm:WidgetsViewModel}">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
          <Border CornerRadius="22" Background="#111216" BorderBrush="#0FFFFFFF" BorderThickness="1" Padding="14,6"><StackPanel Orientation="Horizontal"><TextBlock Text="Show widgets" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><c:ToggleSwitch IsChecked="{Binding ShowWidgets, Mode=TwoWay}" AutomationProperties.Name="Show widgets"/></StackPanel></Border>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="WIDGETS" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" />
          <TextBlock Text="Prism on your desktop" Style="{StaticResource H1}" TextWrapping="Wrap" />
          <TextBlock Text="Live, glanceable, and always within reach." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.08*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <c:GlassCard Margin="0,0,16,0" Padding="18">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <TextBlock DockPanel.Dock="Right" Text="Live, the same as on your desktop" Style="{StaticResource SmallMuted}" VerticalAlignment="Center"/>
              <TextBlock Text="Your widgets" Style="{StaticResource CardTitle}"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
              <v:ScreenMap DockPanel.Dock="Left" Width="210" Height="118" Margin="0,0,18,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PLACEMENT" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Drag a widget on your desktop to move it. Right-click one to resize it, change its background, pin it on top or hide it." Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <Button Content="Line up on the right" Command="{Binding LineUpCommand}" HorizontalAlignment="Left" Padding="16,0" MinHeight="36"/>
              </StackPanel>
            </DockPanel>
            <v:WidgetShowcase/>
          </DockPanel>
        </c:GlassCard>
        <StackPanel Grid.Column="1">
          <c:GlassCard>
            <StackPanel>
              <TextBlock Text="Widgets" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Widgets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#17181D" CornerRadius="14" Padding="12,8" Margin="0,0,0,10"><DockPanel><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}"/><Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{Binding IconBackground}" Margin="0,0,12,0"><c:DeviceIcon Kind="{Binding PreviewIcon}" Color="{Binding IconColor, Converter={StaticResource HexToColor}}" Width="20" Height="20"/></Border><Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource TextAction}" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#F4F5F7"/><TextBlock Text="{Binding DisplaySubtitle}" Style="{StaticResource SmallMuted}" Margin="0,4,0,0"/></StackPanel></Button></DockPanel></Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander Header="Add a widget" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Gallery}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,8,8,8">
                        <Button Content="{Binding Name}" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource BaseButton}" Margin="4" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </c:GlassCard>
          <Border Height="16" />
          <c:GlassCard>
            <StackPanel>
              <TextBlock Text="Look" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="For all widgets" Style="{StaticResource SmallMuted}" Margin="0,2,0,12"/>
              <TextBlock Text="SIZE" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
              <c:SegmentedControl ItemsSource="{Binding Sizes}" SelectedItem="{Binding AllSize, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource OutlinedSegmentItem}"/>
              <TextBlock Text="BACKGROUND" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
              <c:SegmentedControl ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding AllBackground, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource OutlinedSegmentItem}"/>
              <DockPanel Margin="0,16,0,0"><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AllOnTop, Mode=TwoWay}" AutomationProperties.Name="Always on top"/><StackPanel><TextBlock Text="Always on top" FontWeight="SemiBold"/><TextBlock Text="Stay above other windows" Style="{StaticResource SmallMuted}"/></StackPanel></DockPanel>
              <DockPanel Margin="0,12,0,0"><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AllClickThrough, Mode=TwoWay}" AutomationProperties.Name="Click through"/><StackPanel><TextBlock Text="Click through" FontWeight="SemiBold"/><TextBlock Text="Clicks pass to the desktop" Style="{StaticResource SmallMuted}"/></StackPanel></DockPanel>
            </StackPanel>
          </c:GlassCard>
        </StackPanel>
      </Grid>
      <Border Height="16" />
      <c:GlassCard StaggerIndex="2" Span="12">
        <StackPanel>
          <c:SpacedGrid Columns="4" Gap="14">
            <Border Background="#17181D" CornerRadius="16" Padding="14" Height="94"><StackPanel><DockPanel><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows"/><TextBlock Text="Start with Windows" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Prism starts quietly when you sign in" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Background="#17181D" CornerRadius="16" Padding="14" Height="94"><StackPanel><DockPanel><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Settings.StartMinimizedToTray, Mode=TwoWay}" AutomationProperties.Name="Start in the tray"/><TextBlock Text="Start in the tray" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="No window at startup, just the tray" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Background="#17181D" CornerRadius="16" Padding="14" Height="94"><StackPanel><DockPanel><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Settings.KeepRunningWhenClosed, Mode=TwoWay}" AutomationProperties.Name="Close keeps running"/><TextBlock Text="Close keeps running" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Closing the window leaves lights and fans on" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Background="#171C1A" BorderBrush="#403DDC84" BorderThickness="1" CornerRadius="16" Padding="14" Height="94"><StackPanel><TextBlock Text="Background service" FontWeight="SemiBold"/><TextBlock Text="{Binding Settings.ServiceText}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
          </c:SpacedGrid>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
