<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Prism.App.Views.DesktopPreview">
  <Border Background="#101013" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="18" Padding="12">
    <StackPanel>
      <TextBlock Text="Drag a widget to move it. Click to customize." Style="{StaticResource SmallMuted}" Margin="0,0,0,12" />
      <Viewbox Stretch="Fill" Height="540">
        <Canvas x:Name="Surface" Width="1920" Height="1080" ClipToBounds="True">
          <Canvas.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#30181D" Offset="0" />
              <GradientStop Color="#103A4A" Offset="1" />
            </LinearGradientBrush>
          </Canvas.Background>
        </Canvas>
      </Viewbox>
    </StackPanel>
  </Border>
</UserControl>