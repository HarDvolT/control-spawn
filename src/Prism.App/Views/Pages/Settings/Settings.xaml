<ResourceDictionary xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <StackPanel Margin="0,1,0,0">
      <DockPanel Margin="0,0,0,16"><c:StatusChip DockPanel.Dock="Right" Text="Changes save as you go" VerticalAlignment="Bottom"/>
        <StackPanel>
          <TextBlock Text="S&#x200A;E&#x200A;T&#x200A;T&#x200A;I&#x200A;N&#x200A;G&#x200A;S" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SelectedSection}" Style="{StaticResource H1}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SectionSubtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="296" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
          <c:GlassCard Span="3" Padding="10" Height="258">
            <StackPanel>
              <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0">
                <ListBox.ItemTemplate><DataTemplate><DockPanel><Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6" Margin="0,0,12,0"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M18 18h2M14 4v4M8 10v4M16 16v4"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="Devices &amp; access"><Setter Property="Data" Value="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Safety"><Setter Property="Data" Value="M12 3 4 6v7c0 5 8 8 8 8s8-3 8-8V6z"/></DataTrigger><DataTrigger Binding="{Binding}" Value="Backup"><Setter Property="Data" Value="M12 3v12M7 10l5 5 5-5M4 21h16"/></DataTrigger><DataTrigger Binding="{Binding}" Value="About"><Setter Property="Data" Value="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 8v1M12 12v5"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Text="{Binding}" FontSize="14"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Foreground" Value="#A3A6AE"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Chrome" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                              <Setter Property="Foreground" Value="#F4F5F7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2,0,0,0"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </StackPanel>
          </c:GlassCard>
          <Border Height="16" />
          <c:GlassCard Span="3" Padding="16" Height="184">
            <StackPanel>
              <DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Right" Text="{Binding HealthUpdated}" Style="{StaticResource SmallMuted}" Foreground="#7C808A" VerticalAlignment="Center"/><TextBlock Text="Health check" Style="{StaticResource CardTitle}"/></DockPanel>
              <ItemsControl ItemsSource="{Binding HealthRows}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Height="26"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource SmallMuted}" VerticalAlignment="Center" MaxWidth="130" Foreground="#7C808A" FontFamily="{StaticResource NumberFont}" TextTrimming="CharacterEllipsis"/><c:LiveIndicator DockPanel.Dock="Left" Width="7" Height="7" Color="{Binding ColorHex, Converter={StaticResource HexToColor}}" Margin="0,0,10,0"/><TextBlock Text="{Binding Key}" FontSize="13" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </c:GlassCard>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <c:GlassCard Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16" Height="228" Padding="18,6,18,8"><StackPanel>
            <TextBlock Text="D&#x200A;I&#x200A;S&#x200A;P&#x200A;L&#x200A;A&#x200A;Y" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
            <DockPanel Height="69"><c:SegmentedControl DockPanel.Dock="Right" ItemsSource="{Binding TemperatureUnits}" SelectedItem="{Binding TemperatureUnit, Mode=TwoWay}" VerticalAlignment="Center" Width="96"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Temperature unit" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Used everywhere, including widgets" Style="{StaticResource SmallMuted}" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel>
            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"/>
            <DockPanel Height="63"><ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding AccentColors}" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><c:ColorSwatch ColorHex="{Binding}" SelectedHex="{Binding DataContext.AccentColor, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Width="30" Height="30" Margin="8,0,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel VerticalAlignment="Center"><TextBlock Text="Accent colour" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Buttons and active states. Machine readings stay cyan." Style="{StaticResource SmallMuted}" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel>
            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"/>
            <DockPanel Height="63"><c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding ReduceAnimations, Mode=TwoWay}" AutomationProperties.Name="Reduce motion"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Reduce motion" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Turns off glows that pulse and cards that slide in" Style="{StaticResource SmallMuted}" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel>
          </StackPanel></c:GlassCard>
          <c:GlassCard Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16" Height="282" Padding="18,6,18,8"><StackPanel><TextBlock Text="N&#x200A;O&#x200A;T&#x200A;I&#x200A;F&#x200A;I&#x200A;C&#x200A;A&#x200A;T&#x200A;I&#x200A;O&#x200A;N&#x200A;S" Style="{StaticResource SectionLabel}" Margin="0"/>
            <DockPanel Height="63"><c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding NotifyRunningHot, Mode=TwoWay}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Running hot" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="CPU or GPU passes the warning line" Style="{StaticResource SmallMuted}" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel>
            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"/>
            <DockPanel Height="63"><c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding NotifyCookingFinished, Mode=TwoWay}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Air fryer finished" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="And the halfway shake reminder" Style="{StaticResource SmallMuted}" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel>
            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"/>
            <DockPanel Height="63"><c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding NotifyDeviceOffline, Mode=TwoWay}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="A device went offline" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Lamps, fryer or router stop answering" Style="{StaticResource SmallMuted}" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel>
            <Border BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"/>
            <DockPanel Height="63"><c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Updates" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="A new Control Spawn version is ready" Style="{StaticResource SmallMuted}" FontSize="13" Margin="0,2,0,0"/></StackPanel></DockPanel>
          </StackPanel></c:GlassCard>
          <Expander Header="Discovery and lighting notifications" Visibility="{Binding IsAccess, Converter={StaticResource BoolToVisibility}}" Foreground="#A3A6AE"><StackPanel><CheckBox Content="Notify me when new devices are found" IsChecked="{Binding NotifyNewDevices}"/><CheckBox Content="Flash lights when cooking finishes" IsChecked="{Binding CookingLightFlash}"/><c:EventOptionsPanel/></StackPanel></Expander>
          <Expander Header="Startup and background" Foreground="#A3A6AE" Visibility="{Binding IsAccess, Converter={StaticResource BoolToVisibility}}">          <c:GlassCard Margin="0,0,0,16" StaggerIndex="3">
            <StackPanel>
              <TextBlock Text="STARTUP AND DISCOVERY" Style="{StaticResource H2}" Margin="0,4" />
              <CheckBox Content="Notify me when new devices are found" IsChecked="{Binding NotifyNewDevices}" Margin="0,6" />
              <CheckBox Content="Auto-join new RGB devices to sync" IsChecked="{Binding AutoJoinNewRgb}" Margin="0,6" />
              <CheckBox Content="Flash event lights when cooking finishes" IsChecked="{Binding CookingLightFlash}" Margin="0,6" />
              <TextBlock Text="Startup and background" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
              <DockPanel Margin="0,9">
                <c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows" />
                <TextBlock Text="Start with Windows" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              </DockPanel>
              <DockPanel Margin="0,9">
                <c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" AutomationProperties.Name="Start minimized to tray" />
                <TextBlock Text="Start minimized to tray" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              </DockPanel>
              <DockPanel Margin="0,9">
                <c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding KeepRunningWhenClosed, Mode=TwoWay}" AutomationProperties.Name="Keep running when closed" />
                <TextBlock Text="Keep running when closed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              </DockPanel>
              <DockPanel Margin="0,9">
                <c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding ShowWidgetsAtStartup, Mode=TwoWay}" AutomationProperties.Name="Show widgets at startup" />
                <TextBlock Text="Show widgets at startup" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              </DockPanel>
            </StackPanel>
          </c:GlassCard></Expander>
          <c:GlassCard Visibility="{Binding IsBackup, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Backup" Style="{StaticResource CardTitle}"/><TextBlock Text="Backup and restore are not available yet." Style="{StaticResource Placeholder}"/><UniformGrid Columns="2"><Button Content="Export backup" IsEnabled="False" Margin="0,0,12,0"/><Button Content="Restore backup" IsEnabled="False"/></UniformGrid></StackPanel></c:GlassCard>
          <c:GlassCard Margin="0,0,0,16" StaggerIndex="5" Visibility="{Binding IsAccess, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Integrations" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock Text="OpenRGB path" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <TextBox Text="{Binding OpenRgbPath, UpdateSourceTrigger=LostFocus}" Background="#252529" Padding="10" Margin="0,8" />
              <DockPanel Margin="0,9">
                <c:ToggleSwitch DockPanel.Dock="Right" Width="46" Height="26" IsChecked="{Binding RouterEnabled, Mode=TwoWay}" AutomationProperties.Name="Enable router integration" />
                <TextBlock Text="Enable router integration" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              </DockPanel>
              <CheckBox Content="Launch OpenRGB with the service" IsChecked="{Binding LaunchOpenRgb}" Margin="0,8" />
              <TextBlock Text="Router host" Style="{StaticResource Muted}" />
              <TextBox Background="#252529" BorderBrush="#3F3F46" BorderThickness="1" Padding="10" Text="{Binding RouterHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,8" />
              <Button Content="Save service options" Command="{Binding SaveServiceOptionsCommand}" HorizontalAlignment="Left" Margin="0,8" />
              <TextBlock Text="{Binding IntegrationNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
            </StackPanel>
          </c:GlassCard>
          <c:GlassCard Span="9" Visibility="{Binding IsAccess, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="TOKENS &amp; PASSWORDS" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Credentials are encrypted by the service." Style="{StaticResource Muted}" TextWrapping="Wrap" />
              <Button Content="Import tokens" Command="{Binding OpenPageCommand}" CommandParameter="Devices" Style="{StaticResource PillButton}" Margin="0,4,8,4" />
              <Button Content="Router password" Command="{Binding OpenPageCommand}" CommandParameter="Modem" Style="{StaticResource PillButton}" Margin="0,4,8,4" />
            </StackPanel>
          </c:GlassCard>
          <c:GlassCard Span="9" Visibility="{Binding IsSafety, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="FAN SAFETY" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Pump locked at 100%" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
              <TextBlock Text="BIOS hand-back stays armed." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12" />
              <Button Content="Open fan controls →" Command="{Binding OpenPageCommand}" CommandParameter="Fans" Style="{StaticResource PillButton}" Margin="0,4,8,4" />
            </StackPanel>
          </c:GlassCard>
          <c:GlassCard Margin="0,0,0,16" StaggerIndex="0" Visibility="{Binding IsAbout, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="Service" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock Text="{Binding ServiceText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock Text="{Binding ModeText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock Text="{Binding PipeName}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock Text="{Binding LastSavedText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <Button Content="Reset preferences" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding ResetCommand}" />
            </StackPanel>
          </c:GlassCard>
          <Button Visibility="{Binding IsAbout, Converter={StaticResource BoolToVisibility}}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource PillButton}" Margin="0,4,8,4" HorizontalAlignment="Left" />
        </StackPanel>
      </Grid>
      <TextBlock Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>