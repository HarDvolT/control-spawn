<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns:v="clr-namespace:Prism.App.Views">
<DataTemplate DataType="{x:Type vm:SettingsViewModel}"><StackPanel><DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="SETTINGS" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedSection}" Style="{StaticResource H1}" TextWrapping="Wrap" /><TextBlock Text="Changes save as you go" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" /></StackPanel></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="9*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><c:GlassCard Span="3" ><StackPanel><ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chrome" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavActiveBrush}"/><Setter Property="Foreground" Value="#FF8A60"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></StackPanel></c:GlassCard><Border Height="16"/><c:GlassCard Span="3" ><StackPanel><TextBlock Text="Health check" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="{Binding ServiceText}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" /><TextBlock Text="{Binding ModeText}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="{Binding ElevationText}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" /><TextBlock Text="{Binding HealthSummary}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,10"/></StackPanel></c:GlassCard></StackPanel><StackPanel Grid.Column="1"><c:GlassCard Span="9" Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16"><StackPanel><TextBlock Text="DISPLAY" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Temperature unit" Style="{StaticResource CardTitle}" TextWrapping="Wrap" /><TextBlock Text="°C" Style="{StaticResource Number}" TextWrapping="Wrap" /><TextBlock Text="Unavailable · Temperature unit selection requires shared formatting support." Style="{StaticResource Placeholder}" TextWrapping="Wrap" /><DockPanel Margin="0,10"><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ReduceAnimations, Mode=TwoWay}" AutomationProperties.Name="Reduce motion"/><TextBlock Text="Reduce motion" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></StackPanel></c:GlassCard><c:GlassCard Span="9" Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16"><StackPanel><TextBlock Text="NOTIFICATIONS" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><DockPanel Margin="0,10"><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding NotifyNewDevices, Mode=TwoWay}" AutomationProperties.Name="Notify me when new devices are found"/><TextBlock Text="Notify me when new devices are found" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><DockPanel Margin="0,10"><c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CookingLightFlash, Mode=TwoWay}" AutomationProperties.Name="Flash lights when cooking finishes"/><TextBlock Text="Flash lights when cooking finishes" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><c:EventOptionsPanel/></StackPanel></c:GlassCard><c:GlassCard Margin="0,0,0,16" StaggerIndex="3" Visibility="{Binding IsStartup, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="STARTUP AND DISCOVERY" Style="{StaticResource H2}" Margin="0,4" />
          <CheckBox Content="Notify me when new devices are found" IsChecked="{Binding NotifyNewDevices}" Margin="0,6" />
          <CheckBox Content="Auto-join new RGB devices to sync" IsChecked="{Binding AutoJoinNewRgb}" Margin="0,6" />
          <CheckBox Content="Flash event lights when cooking finishes" IsChecked="{Binding CookingLightFlash}" Margin="0,6" />
          <TextBlock Text="Startup and background" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows" />
            <TextBlock Text="Start with Windows" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </DockPanel>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" AutomationProperties.Name="Start minimized to tray" />
            <TextBlock Text="Start minimized to tray" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </DockPanel>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding KeepRunningWhenClosed, Mode=TwoWay}" AutomationProperties.Name="Keep running when closed" />
            <TextBlock Text="Keep running when closed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </DockPanel>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowWidgetsAtStartup, Mode=TwoWay}" AutomationProperties.Name="Show widgets at startup" />
            <TextBlock Text="Show widgets at startup" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </DockPanel>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,16" StaggerIndex="4" Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ReduceAnimations, Mode=TwoWay}" AutomationProperties.Name="Reduce animations" />
            <TextBlock Text="Reduce animations" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </DockPanel>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,16" StaggerIndex="5" Visibility="{Binding IsAccess, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Integrations" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
          <TextBlock Text="OpenRGB path" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          <TextBox Text="{Binding OpenRgbPath, UpdateSourceTrigger=LostFocus}" Background="#252529" Padding="10" Margin="0,8" />
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RouterEnabled, Mode=TwoWay}" AutomationProperties.Name="Enable router integration" />
            <TextBlock Text="Enable router integration" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </DockPanel>
          <CheckBox Content="Launch OpenRGB with the service" IsChecked="{Binding LaunchOpenRgb}" Margin="0,8" />
          <TextBlock Text="Router host" Style="{StaticResource Muted}" />
          <TextBox Background="#252529" BorderBrush="#3F3F46" BorderThickness="1" Padding="10" Text="{Binding RouterHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,8" />
          <Button Content="Save service options" Command="{Binding SaveServiceOptionsCommand}" HorizontalAlignment="Left" Margin="0,8" />
          <TextBlock Text="{Binding IntegrationNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Span="9" Visibility="{Binding IsAccess, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16"><StackPanel><TextBlock Text="TOKENS &amp; PASSWORDS" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Credentials are encrypted by the service." Style="{StaticResource Muted}" TextWrapping="Wrap" /><Button Content="Import tokens" Command="{Binding OpenPageCommand}" CommandParameter="Devices" Style="{StaticResource PillButton}" Margin="0,4,8,4"/><Button Content="Router password" Command="{Binding OpenPageCommand}" CommandParameter="Modem" Style="{StaticResource PillButton}" Margin="0,4,8,4"/></StackPanel></c:GlassCard><c:GlassCard Span="9" Visibility="{Binding IsSafety, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16"><StackPanel><TextBlock Text="FAN SAFETY" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Pump locked at 100%" Style="{StaticResource CardTitle}" TextWrapping="Wrap" /><TextBlock Text="BIOS hand-back stays armed." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12"/><Button Content="Open fan controls →" Command="{Binding OpenPageCommand}" CommandParameter="Fans" Style="{StaticResource PillButton}" Margin="0,4,8,4"/></StackPanel></c:GlassCard><c:GlassCard Margin="0,0,0,16" StaggerIndex="0" Visibility="{Binding IsAbout, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="Service" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
          <TextBlock Text="{Binding ServiceText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          <TextBlock Text="{Binding ModeText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          <TextBlock Text="{Binding PipeName}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          <TextBlock Text="{Binding LastSavedText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          <Button Content="Reset preferences" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding ResetCommand}" />
        </StackPanel>
      </c:GlassCard>
      <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource PillButton}" Margin="0,4,8,4"/></StackPanel></Grid><TextBlock Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12"/></StackPanel></DataTemplate></ResourceDictionary>