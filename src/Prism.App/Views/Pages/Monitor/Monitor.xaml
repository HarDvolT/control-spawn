<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns:v="clr-namespace:Prism.App.Views">
<DataTemplate DataType="{x:Type vm:MonitorViewModel}"><StackPanel><DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom"><c:SegmentedControl ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}" Margin="0,4,0,12"/></StackPanel><StackPanel><TextBlock Text="MONITOR" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" /><TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" TextWrapping="Wrap" /><TextBlock Text="Live readings · CPU, GPU, memory and more" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" /></StackPanel></DockPanel><c:CardGrid><c:GlassCard StaggerIndex="5" Span="4">
          <StackPanel>
            <TextBlock Text="CPU" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
            <c:RadialGauge Value="{Binding CpuLoad}" Suffix="%" Height="120" /><TextBlock Text="{Binding CpuPercentText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4" />
            <c:LineChart Height="145" Margin="0,10" Values="{Binding CpuHistory}" />
            <ItemsControl ItemsSource="{Binding CpuStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Number}" />
                    <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Per-thread load" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4" />
            <ItemsControl ItemsSource="{Binding Threads}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <c:GlowProgressBar Width="80" Height="18" Margin="4" Value="{Binding Percent}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard StaggerIndex="0" Span="4">
          <StackPanel>
            <TextBlock Text="GPU" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
            <c:RadialGauge Value="{Binding GpuLoad}" Suffix="%" Height="120" /><TextBlock Text="{Binding GpuPercentText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4" />
            <c:GlowProgressBar Value="{Binding GpuLoad}" />
            <ItemsControl ItemsSource="{Binding GpuStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Number}" />
                    <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="VRAM" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Text="{Binding VramText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
            <c:GlowProgressBar Value="{Binding VramPercent}" />
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="4" ><StackPanel><TextBlock Text="Memory &amp; temperatures" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel>
            <TextBlock Text="Memory" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Text="{Binding RamText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4" />
            <c:GlowProgressBar Value="{Binding RamPercent}" />
            <TextBlock Text="Vengeance RGB DDR5 · 6000 MT/s" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Text="{Binding Dimm1Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
            <TextBlock Text="{Binding Dimm2Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
          </StackPanel>
        <StackPanel>
            <TextBlock Text="Temperatures" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4" />
            <ItemsControl ItemsSource="{Binding Temps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,5">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel></c:GlassCard><c:GlassCard Span="6" ><StackPanel><TextBlock Text="Fans" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Fans}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,9"><c:FanRotor DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" Color="#36D6FF"/><StackPanel DockPanel.Dock="Right"><TextBlock Text="{Binding RpmText}" Style="{StaticResource Number}" TextWrapping="Wrap" FontSize="20" Foreground="{StaticResource DataBrush}"/></StackPanel><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" /><TextBlock Text="{Binding Sub}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" /><c:GlowProgressBar Value="{Binding Percent}" Height="8" Margin="0,8,12,0" BarColor="#36D6FF"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></c:GlassCard><c:GlassCard Span="3" ><StackPanel><TextBlock Text="Network &amp; disks" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="{Binding NetDownText}" Style="{StaticResource Number}" TextWrapping="Wrap" /><TextBlock Text="{Binding NetUpText}" Style="{StaticResource Number}" TextWrapping="Wrap" /><c:LineChart Height="70" Values="{Binding NetDownHistory}" SecondaryValues="{Binding NetUpHistory}"/><TextBlock Text="Storage" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock Text="{Binding DiskTempText}" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock Text="{Binding DiskReadText}" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock Text="{Binding DiskWriteText}" Style="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel></c:GlassCard><c:GlassCard Span="3" ><StackPanel><TextBlock Text="Internet" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="{Binding State.Router.Verdict}" Style="{StaticResource Number}" TextWrapping="Wrap" /><TextBlock Text="{Binding State.Router.Network}" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock Text="{Binding State.Router.Band}" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock Text="{Binding State.Router.Sentence}" Style="{StaticResource Muted}" TextWrapping="Wrap" /><Button Content="Open →" Command="{Binding OpenPageCommand}" CommandParameter="Modem" Style="{StaticResource PillButton}" Margin="0,4,8,4"/></StackPanel></c:GlassCard><c:GlassCard Span="6" ><StackPanel><TextBlock Text="Top processes" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Unavailable · Process telemetry is not supplied by the service." Style="{StaticResource Placeholder}" TextWrapping="Wrap" /></StackPanel></c:GlassCard><c:GlassCard Span="6" ><StackPanel><TextBlock Text="Power &amp; uptime" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="{Binding PowerText}" Style="{StaticResource Number}" TextWrapping="Wrap" /><TextBlock Text="{Binding PeakText}" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock Text="Unavailable · Uptime and throttling events are not supplied by the service." Style="{StaticResource Placeholder}" TextWrapping="Wrap" /></StackPanel></c:GlassCard></c:CardGrid><TextBlock Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12"/></StackPanel></DataTemplate></ResourceDictionary>