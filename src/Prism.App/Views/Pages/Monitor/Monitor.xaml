<ResourceDictionary xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="clr-namespace:Prism.App.Controls">
  <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <c:SegmentedControl DockPanel.Dock="Right" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}" VerticalAlignment="Bottom" />
        <StackPanel>
          <TextBlock Text="MONITOR" Style="{StaticResource PageEyebrow}" />
          <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" />
          <TextBlock Text="Live readings · CPU, GPU, memory and more" Style="{StaticResource PageSubtitle}" />
        </StackPanel>
      </DockPanel>
      <c:CardGrid>
        <c:GlassCard Span="4" Height="300">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Processor" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <UniformGrid Columns="2">
              <c:RingGauge Value="{Binding CpuLoad}" Suffix="%" SweepAngle="270" Width="100" Height="100" RingColor="#36D6FF" />
              <c:RingGauge Value="{Binding State.System.CpuTemp}" Suffix="°" SweepAngle="270" Width="100" Height="100" RingColor="#3DDC84" />
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding CpuStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Number}" FontSize="13" DockPanel.Dock="Right" />
                    <TextBlock Text="{Binding Key}" Style="{StaticResource SmallMuted}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="THREADS" Style="{StaticResource SmallMuted}" Margin="0,10,0,6" />
            <ItemsControl ItemsSource="{Binding Threads}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <c:GlowProgressBar Value="{Binding Percent}" BarColor="#36D6FF" Height="8" Margin="2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="4" Height="300">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Graphics" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <UniformGrid Columns="2">
              <c:RingGauge Value="{Binding GpuLoad}" Suffix="%" SweepAngle="270" Width="100" Height="100" RingColor="#36D6FF" />
              <c:RingGauge Value="{Binding State.System.GpuTemp}" Suffix="°" SweepAngle="270" Width="100" Height="100" RingColor="#3DDC84" />
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding GpuStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,3">
                    <TextBlock Text="{Binding Value}" Style="{StaticResource Number}" FontSize="13" DockPanel.Dock="Right" />
                    <TextBlock Text="{Binding Key}" Style="{StaticResource SmallMuted}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding VramText}" Style="{StaticResource SmallMuted}" Margin="0,10,0,6" />
            <c:GlowProgressBar Value="{Binding VramPercent}" BarColor="#36D6FF" Height="8" />
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="4" Height="300">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Memory &amp; temperatures" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding RamText}" Style="{StaticResource Number}" FontSize="24" Margin="0,4,0,10" />
            <c:GlowProgressBar Value="{Binding RamPercent}" BarColor="#B26BFF" Height="10" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding Temps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,4">
                    <TextBlock Text="{Binding Value}" Style="{StaticResource SmallMuted}" DockPanel.Dock="Right" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SmallMuted}" DockPanel.Dock="Left" Width="86" />
                    <c:GlowProgressBar Value="{Binding Percent}" BarColor="{Binding ColorHex, Converter={StaticResource HexToColor}}" Height="5" VerticalAlignment="Center" Margin="6,0,12,0" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="6" Height="200">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Fans" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Fans}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <c:RingGauge Value="{Binding Percent}" Suffix="%" SweepAngle="270" Width="100" Height="100" RingColor="#36D6FF" />
                    <TextBlock Text="{Binding RpmText}" Style="{StaticResource Number}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SmallMuted}" HorizontalAlignment="Center" Margin="0,4" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="3" Height="200">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Network &amp; disks" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding NetDownText}" Style="{StaticResource Number}" FontSize="19" Foreground="{StaticResource DataBrush}" />
            <TextBlock Text="{Binding NetUpText}" Style="{StaticResource SmallMuted}" Margin="0,4" />
            <TextBlock Text="Storage" Style="{StaticResource CardTitle}" Margin="0,16,0,8" />
            <TextBlock Text="{Binding DiskTempText}" Style="{StaticResource SmallMuted}" />
            <TextBlock Text="{Binding DiskReadText}" Style="{StaticResource SmallMuted}" Margin="0,4" />
            <TextBlock Text="{Binding DiskWriteText}" Style="{StaticResource SmallMuted}" />
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="3" Height="200">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Internet" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding State.Router.Verdict}" Style="{StaticResource Number}" Foreground="{StaticResource StatusWarmBrush}" FontSize="22" />
            <TextBlock Text="{Binding State.Router.Network}" Style="{StaticResource SmallMuted}" Margin="0,8" />
            <TextBlock Text="{Binding State.Router.Sentence}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" />
            <Button Content="Open →" Command="{Binding OpenPageCommand}" CommandParameter="Modem" Style="{StaticResource TextAction}" HorizontalAlignment="Left" Margin="0,12,0,0" />
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="6" MinHeight="128">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Top processes" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <TextBlock Text="Unavailable · Process telemetry is not supplied by the service." Style="{StaticResource Placeholder}" />
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Span="6" MinHeight="128">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="Power &amp; uptime" Style="{StaticResource CardTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding PowerText}" Style="{StaticResource Number}" FontSize="18" />
            <TextBlock Text="{Binding PeakText}" Style="{StaticResource SmallMuted}" Margin="0,8" />
            <TextBlock Text="Unavailable · Uptime and throttling events are not supplied by the service." Style="{StaticResource Placeholder}" />
          </StackPanel>
        </c:GlassCard>
      </c:CardGrid>
      <TextBlock Text="{Binding LastError}" Style="{StaticResource Muted}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>