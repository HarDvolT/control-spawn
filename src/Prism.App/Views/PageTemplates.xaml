<?xml version="1.0" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Prism.App.Controls" xmlns:vm="clr-namespace:Prism.App.ViewModels" xmlns:v="clr-namespace:Prism.App.Views">
  <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
    <StackPanel>
      <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,4"/>
      <TextBlock Text="{Binding MachineLine}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
      <ItemsControl ItemsSource="{Binding Scenes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Name}" Command="{Binding DataContext.ApplySceneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}" Style="{StaticResource BaseButton}" Margin="4"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Gauges}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <c:GlassCard Width="190" Margin="0,12,14,18" StaggerIndex="0">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4"/>
                <c:RingGauge Width="125" Height="125" Value="{Binding Percent}" ShowValue="False" RingColor="{Binding ColorHex, Converter={StaticResource HexToColor}}"/>
                <c:NumberTicker Value="{Binding NumericValue}" ValueFormat="{Binding ValueFormat}" Suffix="{Binding Suffix}" FontSize="28" Margin="0,4"/>
                <TextBlock Text="{Binding Sub}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,4"/>
              </StackPanel>
            </c:GlassCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.2*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <c:GlassCard Margin="0,0,0,18" StaggerIndex="1">
            <StackPanel>
              <TextBlock Text="System load · recent samples" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
              <c:LineChart Height="145" Margin="0,10" Values="{Binding CpuHistory}" SecondaryValues="{Binding GpuHistory}"/>
            </StackPanel>
          </c:GlassCard>
          <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
            <StackPanel>
              <TextBlock Text="Fans" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
              <c:SegmentedControl Margin="0,10" ItemsSource="{Binding FanModes}" SelectedItem="{Binding SelectedFanMode, Mode=TwoWay}"/>
              <ItemsControl ItemsSource="{Binding Fans}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding RpmText}" Style="{StaticResource Number}"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Sub}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,4"/>
                      <c:GlowProgressBar Value="{Binding Percent}" Height="18" ShowLabel="True"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Edit curves" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding OpenPageCommand}" CommandParameter="Fans"/>
            </StackPanel>
          </c:GlassCard>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0">
          <c:GlassCard Margin="0,0,0,18" StaggerIndex="3">
            <StackPanel>
              <TextBlock Text="{Binding LightingTitle}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
              <TextBlock Text="{Binding LightingSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
              <c:LedStrip Height="55" EffectKind="{Binding LightingEffect}" ColorHex="{Binding LightingColorHex}" Brightness="{Binding LightingBrightness}" Speed="{Binding LightingSpeed}"/>
              <Button Content="Effects" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding OpenPageCommand}" CommandParameter="Lighting"/>
            </StackPanel>
          </c:GlassCard>
          <c:GlassCard Margin="0,0,0,18" StaggerIndex="4">
            <StackPanel>
              <TextBlock Text="Yeelight lamp" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
              <DockPanel Margin="0,9">
                <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding LampOn, Mode=TwoWay}" AutomationProperties.Name="On"/>
                <TextBlock Text="On" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
              </DockPanel>
              <TextBlock Text="{Binding LampSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
              <StackPanel Margin="0,8">
                <TextBlock Text="Brightness" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding LampBrightness, Converter={StaticResource Percent}}" TextAlignment="Right"/>
                  <c:ThickSlider Minimum="1" Maximum="100" Value="{Binding LampBrightness, Mode=TwoWay}" AutomationProperties.Name="Brightness" VerticalAlignment="Center"/>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </c:GlassCard>
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
    <StackPanel>
      <c:SegmentedControl Margin="0,10" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange, Mode=TwoWay}"/>
      <UniformGrid Columns="2">
        <c:GlassCard Margin="0,0,16,18" StaggerIndex="5">
          <StackPanel>
            <TextBlock Text="CPU · Ryzen 7 9800X3D" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding CpuPercentText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4"/>
            <c:LineChart Height="145" Margin="0,10" Values="{Binding CpuHistory}"/>
            <ItemsControl ItemsSource="{Binding CpuStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Number}"/>
                    <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Per-thread load" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4"/>
            <ItemsControl ItemsSource="{Binding Threads}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <c:GlowProgressBar Width="80" Height="18" Margin="4" Value="{Binding Percent}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Margin="0,0,16,18" StaggerIndex="0">
          <StackPanel>
            <TextBlock Text="GPU · RX 9070 XT Taichi" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding GpuPercentText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4"/>
            <c:GlowProgressBar Value="{Binding GpuLoad}"/>
            <ItemsControl ItemsSource="{Binding GpuStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Number}"/>
                    <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="VRAM" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding VramText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <c:GlowProgressBar Value="{Binding VramPercent}"/>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Margin="0,0,16,18" StaggerIndex="1">
          <StackPanel>
            <TextBlock Text="Memory" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding RamText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4"/>
            <c:GlowProgressBar Value="{Binding RamPercent}"/>
            <TextBlock Text="Vengeance RGB DDR5 · 6000 MT/s" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding Dimm1Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding Dimm2Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Margin="0,0,16,18" StaggerIndex="2">
          <StackPanel>
            <TextBlock Text="Temperatures" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <ItemsControl ItemsSource="{Binding Temps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,5">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Margin="0,0,16,18" StaggerIndex="3">
          <StackPanel>
            <TextBlock Text="Fans" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <ItemsControl ItemsSource="{Binding Fans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,8">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding RpmText}" Style="{StaticResource Number}"/>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,4"/>
                    <c:GlowProgressBar Value="{Binding Percent}" Height="18" ShowLabel="True"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Margin="0,0,16,18" StaggerIndex="4">
          <StackPanel>
            <TextBlock Text="Storage" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding DiskTempText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding DiskReadText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding DiskWriteText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <ItemsControl ItemsSource="{Binding DiskBars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="6" Height="{Binding Height}" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="2" VerticalAlignment="Bottom"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Margin="0,0,16,18" StaggerIndex="5">
          <StackPanel>
            <TextBlock Text="Network" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding NetDownText}" Style="{StaticResource Number}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding NetUpText}" Style="{StaticResource Number}" TextWrapping="Wrap" Margin="0,4"/>
            <c:LineChart Height="145" Margin="0,10" Values="{Binding NetDownHistory}" SecondaryValues="{Binding NetUpHistory}"/>
          </StackPanel>
        </c:GlassCard>
      </UniformGrid>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:LightingViewModel}">
    <StackPanel>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="0">
        <StackPanel>
          <TextBlock Text="{Binding EffectName}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding EffectSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding SyncCountText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <c:LedStrip Height="80" Margin="0,15" EffectKind="{Binding Effect}" ColorHex="{Binding ColorHex}" Brightness="{Binding Brightness}" Speed="{Binding Speed}" Temperature="{Binding Temperature}"/>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="1">
        <StackPanel>
          <TextBlock Text="Effect" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <ItemsControl ItemsSource="{Binding Effects}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Name}" Command="{Binding DataContext.SelectEffectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource BaseButton}" Margin="4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
        <StackPanel>
          <TextBlock Text="Settings" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <ItemsControl ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="36" Height="36" Margin="4" Background="{Binding Converter={StaticResource HexToBrush}}" Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Margin="0,8">
            <TextBlock Text="Brightness" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding BrightnessPercent, Converter={StaticResource Percent}}" TextAlignment="Right"/>
              <c:ThickSlider Minimum="0" Maximum="100" Value="{Binding BrightnessPercent, Mode=TwoWay}" AutomationProperties.Name="Brightness" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
          <StackPanel Margin="0,8">
            <TextBlock Text="Speed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding SpeedPercent, Converter={StaticResource Percent}}" TextAlignment="Right"/>
              <c:ThickSlider Minimum="0" Maximum="100" Value="{Binding SpeedPercent, Mode=TwoWay}" AutomationProperties.Name="Speed" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="3">
        <StackPanel>
          <TextBlock Text="Devices in sync" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,9">
                  <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Synced, Mode=TwoWay}" Command="{Binding DataContext.SetDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="4">
        <StackPanel>
          <TextBlock Text="Yeelight lamp" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <WrapPanel>
            <Button Content="Same as PC" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetFollowCommand}" CommandParameter="pc"/>
            <Button Content="Average of PC colours" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetFollowCommand}" CommandParameter="average"/>
            <Button Content="Own colour" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetFollowCommand}" CommandParameter="own"/>
          </WrapPanel>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:FansViewModel}">
    <StackPanel>
      <c:SegmentedControl Margin="0,10" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedModeName, Mode=TwoWay}"/>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="5">
        <StackPanel>
          <TextBlock Text="Fan groups" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <ItemsControl ItemsSource="{Binding Fans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,6">
                  <Button Content="{Binding Name}" Command="{Binding DataContext.SelectFanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource BaseButton}" Margin="4"/>
                  <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  <TextBlock Text="{Binding RpmText}" Style="{StaticResource Number}" TextWrapping="Wrap" Margin="0,4"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="AIO pump is fixed at 100%. Above 90 °C the service forces every controllable fan to 100%." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="0">
        <StackPanel>
          <TextBlock Text="{Binding SelectedFanName}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding CurveSubtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SourceName}" Margin="0,10"/>
          <c:FanCurveEditor Height="300" Points="{Binding Curve}" NowTemperature="{Binding NowTemp}" NowPercent="{Binding NowPercent}" IsEnabled="{Binding IsPumpSelected, Converter={StaticResource InverseBool}}"/>
          <StackPanel Margin="0,8">
            <TextBlock Text="Minimum speed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding MinSpeed, Converter={StaticResource Percent}}" TextAlignment="Right"/>
              <c:ThickSlider Minimum="0" Maximum="60" Value="{Binding MinSpeed, Mode=TwoWay}" AutomationProperties.Name="Minimum speed" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
          <TextBlock Text="Minimum is applied when sending the curve. Fan smoothing is managed by the service." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <Button Content="Apply curve" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding ApplyCurveCommand}"/>
          <TextBlock Text="{Binding MeasureText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:LampViewModel}">
    <StackPanel>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="1">
        <StackPanel>
          <TextBlock Text="Yeelight colour bulb" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding StateText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding On, Mode=TwoWay}" AutomationProperties.Name="Power"/>
            <TextBlock Text="Power" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
          <StackPanel Margin="0,8">
            <TextBlock Text="Brightness" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding Brightness, Converter={StaticResource Percent}}" TextAlignment="Right"/>
              <c:ThickSlider Minimum="1" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}" AutomationProperties.Name="Brightness" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="36" Height="36" Margin="4" Background="{Binding Converter={StaticResource HexToBrush}}" Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel>
            <Button Content="Same as PC" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetFollowCommand}" CommandParameter="pc"/>
            <Button Content="Average colours" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetFollowCommand}" CommandParameter="average"/>
            <Button Content="Own colour" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetFollowCommand}" CommandParameter="own"/>
          </WrapPanel>
          <TextBlock Text="{Binding FollowText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
        <StackPanel>
          <TextBlock Text="Mi Home token" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <v:TokenEntry/>
          <TextBlock Text="{Binding TokenNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:ScenesViewModel}">
    <StackPanel>
      <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
      <ItemsControl ItemsSource="{Binding Scenes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <c:GlassCard Width="300" Margin="0,12,18,12" StaggerIndex="3">
              <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Text="{Binding Trigger}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Text="{Binding LightingText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Text="{Binding FansText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                <TextBlock Text="{Binding LampText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                <c:GlowProgressBar Value="{Binding Noise}"/>
                <TextBlock Text="{Binding NoiseText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                <Button Content="{Binding ButtonLabel}" Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Name}" Style="{StaticResource BaseButton}" Margin="4"/>
              </StackPanel>
            </c:GlassCard>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="4">
        <StackPanel>
          <TextBlock Text="Switch automatically" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="Automation rules require a future service protocol. Presets can be applied above." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:ModemViewModel}">
    <StackPanel>
      <c:SegmentedControl Margin="0,10" ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView, Mode=TwoWay}"/>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="5">
        <StackPanel>
          <TextBlock Text="{Binding Network}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding Band}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding Verdict}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding BarsText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <c:RingGauge Width="140" Height="140" Caption="signal score" Suffix="" Value="{Binding Score}"/>
          <TextBlock Text="{Binding Sentence}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding ServiceLine}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
        </StackPanel>
      </c:GlassCard>
      <StackPanel Visibility="{Binding IsSimple, Converter={StaticResource BoolToVisibility}}">
        <c:GlassCard Margin="0,0,0,18" StaggerIndex="0">
          <StackPanel>
            <TextBlock Text="Connection at a glance" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <ItemsControl ItemsSource="{Binding SimpleRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Net}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                    <ItemsControl ItemsSource="{Binding Bars}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Width="6" Height="{Binding Height}" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="2" VerticalAlignment="Bottom"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TrendText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </StackPanel>
        </c:GlassCard>
      </StackPanel>
      <StackPanel Visibility="{Binding IsDetailed, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl ItemsSource="{Binding MetricGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <c:GlassCard Margin="0,0,0,18" StaggerIndex="1">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
                  <TextBlock Text="{Binding Code}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4"/>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,8">
                          <TextBlock Text="{Binding Net}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                          <TextBlock Text="{Binding Value}" Style="{StaticResource Number}" TextWrapping="Wrap" Margin="0,4"/>
                          <TextBlock Text="{Binding Rating}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                          <c:GlowProgressBar Value="{Binding Position}" BarColor="{Binding ColorHex, Converter={StaticResource HexToColor}}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </c:GlassCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Lanes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
                  <TextBlock Text="{Binding Now}" Style="{StaticResource Number}" TextWrapping="Wrap" Margin="0,4"/>
                  <c:LineChart Height="145" Margin="0,10" Values="{Binding Values}"/>
                </StackPanel>
              </c:GlassCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <c:GlassCard Margin="0,0,0,18" StaggerIndex="3">
          <StackPanel>
            <TextBlock Text="Serving cell" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding BandText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding PciText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding EnodebText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding AnchorText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <Button Content="{Binding CopyLabel}" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding CopyCommand}"/>
          </StackPanel>
        </c:GlassCard>
      </StackPanel>
      <StackPanel Visibility="{Binding IsScan, Converter={StaticResource BoolToVisibility}}">
        <c:GlassCard Margin="0,0,0,18" StaggerIndex="4">
          <StackPanel>
            <TextBlock Text="Where your SINR sits" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding SinrNow}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4"/>
            <c:GlowProgressBar Value="{Binding SinrKnob}"/>
            <TextBlock Text="−10 dB · poor → 30 dB · great" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </StackPanel>
        </c:GlassCard>
        <c:GlassCard Margin="0,0,0,18" StaggerIndex="5">
          <StackPanel>
            <TextBlock Text="Neighbor cells" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="Band        PCI        RSRP        SINR" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4"/>
            <ItemsControl ItemsSource="{Binding Neighbors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <WrapPanel>
                    <TextBlock Text="{Binding Band}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding Pci}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding Rsrp}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding Sinr}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Neighbor cell readings are not supplied by the current service protocol." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </StackPanel>
        </c:GlassCard>
      </StackPanel>
      <StackPanel Visibility="{Binding IsSpeed, Converter={StaticResource BoolToVisibility}}">
        <c:GlassCard Margin="0,0,0,18" StaggerIndex="0">
          <StackPanel>
            <TextBlock Text="Speed test" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <Button Content="Run speed test" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding RunSpeedTestCommand}"/>
            <TextBlock Text="{Binding SpeedStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <ItemsControl ItemsSource="{Binding SpeedStats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Number}"/>
                    <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Download, upload and result history are not supplied by the current service protocol." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </StackPanel>
        </c:GlassCard>
      </StackPanel>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="1">
        <StackPanel>
          <TextBlock Text="Ping · latest service samples" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding PingNowText}" Style="{StaticResource NumberLarge}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding LossText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <ItemsControl ItemsSource="{Binding Pings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="6" Height="{Binding Height}" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" Margin="2" VerticalAlignment="Bottom"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Spike detective" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding ToggleSpikesCommand}"/>
          <TextBlock Text="{Binding SpikeCountText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <StackPanel Visibility="{Binding SpikesOpen, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Spikes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,8">
                    <TextBlock Text="{Binding Ms}" Style="{StaticResource Number}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding Cause}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4"/>
                    <TextBlock Text="{Binding Tip}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
        <StackPanel>
          <TextBlock Text="Connected devices" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding DevicesOnlineText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,8">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,4"/>
                  <TextBlock Text="{Binding Connection}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <StackPanel>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="3">
        <StackPanel>
          <TextBlock Text="Startup and background" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" AutomationProperties.Name="Start with Windows"/>
            <TextBlock Text="Start with Windows" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" AutomationProperties.Name="Start minimized to tray"/>
            <TextBlock Text="Start minimized to tray" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding KeepRunningWhenClosed, Mode=TwoWay}" AutomationProperties.Name="Keep running when closed"/>
            <TextBlock Text="Keep running when closed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowWidgetsAtStartup, Mode=TwoWay}" AutomationProperties.Name="Show widgets at startup"/>
            <TextBlock Text="Show widgets at startup" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="4">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ReduceAnimations, Mode=TwoWay}" AutomationProperties.Name="Reduce animations"/>
            <TextBlock Text="Reduce animations" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="5">
        <StackPanel>
          <TextBlock Text="Integrations" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="OpenRGB path" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBox Text="{Binding OpenRgbPath, UpdateSourceTrigger=LostFocus}" Background="#252529" Padding="10" Margin="0,8"/>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RouterEnabled, Mode=TwoWay}" AutomationProperties.Name="Enable router integration"/>
            <TextBlock Text="Enable router integration" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
          <TextBlock Text="{Binding IntegrationNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="0">
        <StackPanel>
          <TextBlock Text="Service" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding ServiceText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding ModeText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding PipeName}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <TextBlock Text="{Binding LastSavedText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          <Button Content="Reset preferences" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding ResetCommand}"/>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:WidgetsViewModel}">
    <StackPanel>
      <TextBlock Text="Desktop widgets" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,4"/>
      <TextBlock Text="Pin any part of Prism to your desktop. Select a preview to customize it." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
      <Button Content="{Binding VisibilityLabel}" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding ToggleVisibilityCommand}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <v:DesktopPreview VerticalAlignment="Top" Margin="0,0,18,18"/>
        <c:GlassCard Margin="0,0,0,18" StaggerIndex="1" Grid.Column="1">
          <StackPanel>
            <TextBlock Text="{Binding SelectedName}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
            <TextBlock Text="{Binding SelectedHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            <WrapPanel>
              <Button Content="Small" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetSizeCommand}" CommandParameter="Small"/>
              <Button Content="Medium" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetSizeCommand}" CommandParameter="Medium"/>
              <Button Content="Large" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding SetSizeCommand}" CommandParameter="Large"/>
            </WrapPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.ShowCpu, Mode=TwoWay}" AutomationProperties.Name="CPU usage"/>
              <TextBlock Text="CPU usage" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.ShowGpu, Mode=TwoWay}" AutomationProperties.Name="GPU usage"/>
              <TextBlock Text="GPU usage" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.ShowTemps, Mode=TwoWay}" AutomationProperties.Name="Temperatures"/>
              <TextBlock Text="Temperatures" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.ShowRam, Mode=TwoWay}" AutomationProperties.Name="Memory"/>
              <TextBlock Text="Memory" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.ShowNet, Mode=TwoWay}" AutomationProperties.Name="Network speed"/>
              <TextBlock Text="Network speed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <StackPanel Margin="0,8">
              <TextBlock Text="Background opacity" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding Selected.OpacityPercent, Converter={StaticResource Percent}}" TextAlignment="Right"/>
                <c:ThickSlider Minimum="20" Maximum="100" Value="{Binding Selected.OpacityPercent, Mode=TwoWay}" AutomationProperties.Name="Background opacity" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.AlwaysOnTop, Mode=TwoWay}" AutomationProperties.Name="Always on top"/>
              <TextBlock Text="Always on top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.ClickThrough, Mode=TwoWay}" AutomationProperties.Name="Click-through"/>
              <TextBlock Text="Click-through" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.Locked, Mode=TwoWay}" AutomationProperties.Name="Lock position"/>
              <TextBlock Text="Lock position" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <DockPanel Margin="0,9">
              <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Selected.SnapToGrid, Mode=TwoWay}" AutomationProperties.Name="Snap to 8 px grid"/>
              <TextBlock Text="Snap to 8 px grid" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
            </DockPanel>
            <Button Content="Remove from desktop" Style="{StaticResource BaseButton}" Margin="0,5,8,5" Command="{Binding RemoveCommand}"/>
          </StackPanel>
        </c:GlassCard>
      </Grid>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="2">
        <StackPanel>
          <TextBlock Text="Startup and background" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Settings.ShowWidgetsAtStartup, Mode=TwoWay}" AutomationProperties.Name="Show widgets at startup"/>
            <TextBlock Text="Show widgets at startup" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
          <DockPanel Margin="0,9">
            <c:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Settings.KeepRunningWhenClosed, Mode=TwoWay}" AutomationProperties.Name="Keep running when closed"/>
            <TextBlock Text="Keep running when closed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
          </DockPanel>
        </StackPanel>
      </c:GlassCard>
      <c:GlassCard Margin="0,0,0,18" StaggerIndex="3">
        <StackPanel>
          <TextBlock Text="Add a widget" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4"/>
          <ItemsControl ItemsSource="{Binding Gallery}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="210" Margin="0,8,8,8">
                  <Button Content="{Binding Name}" Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource BaseButton}" Margin="4"/>
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </c:GlassCard>
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4"/>
      <TextBlock Text="{Binding LastError}" Foreground="#FF8A8A" TextWrapping="Wrap" Margin="0,12"/>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
