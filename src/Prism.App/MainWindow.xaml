<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Prism.App.Controls" x:Class="Prism.App.MainWindow" Title="Prism" Width="1320" Height="900" MinWidth="1000" MinHeight="650" WindowStyle="None" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextPrimaryBrush}" KeyDown="WindowKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18181B" Offset="0"/>
        <GradientStop Color="#0A0A0B" Offset="0.3"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="#AF101012" BorderBrush="#10FFFFFF" BorderThickness="0,0,1,0" Padding="20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="◈  Prism" Style="{StaticResource H1}" Foreground="{StaticResource AccentBrush}" Margin="8,10,0,32"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="{Binding ServiceStatusText}" FontSize="12" Margin="0,16"/>
          <TextBlock Text="{Binding ModeBadge}" Foreground="{StaticResource AccentBrush}"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding NavigationGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="12,8"/>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Definition.Key}" Margin="0,2">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="#26FF4D1A"/>
                                <Setter Property="Foreground" Value="#FF7A50"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Glyph}" Width="27"/>
                          <TextBlock Text="{Binding Title}"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="76"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag">
        <DockPanel Margin="28,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="−" Style="{StaticResource IconButton}" Click="MinimizeClick"/>
            <Button Content="□" Style="{StaticResource IconButton}" Click="MaximizeClick"/>
            <Button Content="×" Style="{StaticResource IconButton}" Click="CloseClick"/>
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="Search   Ctrl+Space" Style="{StaticResource GhostButton}" Command="{Binding OpenSearchCommand}" Margin="12,0"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding BreadcrumbLeft}" Style="{StaticResource Muted}"/>
            <TextBlock Text=" / " Margin="8,0"/>
            <TextBlock Text="{Binding BreadcrumbTitle}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Background="#33F5A524" Padding="24,12" Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap"/>
      </Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl Margin="30,24" Content="{Binding CurrentPage}"/>
      </ScrollViewer>
      <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource SmallMuted}" Margin="30,3"/>
    </Grid>
    <Border Grid.ColumnSpan="2" Background="#D9000000" Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Background="#202024" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20" Width="620" Padding="24" VerticalAlignment="Top" Margin="0,105,0,0">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Esc" Style="{StaticResource BaseButton}" Command="{Binding CloseSearchCommand}"/>
            <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="20" MinHeight="44" ToolTip="Search pages and commands"/>
          </DockPanel>
          <ListBox x:Name="SearchList" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" Margin="0,12" MouseDoubleClick="SearchActivate">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="8">
                  <TextBlock Text="{Binding Title}"/>
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallMuted}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
