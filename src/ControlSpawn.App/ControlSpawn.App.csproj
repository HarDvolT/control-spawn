<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>ControlSpawn.App.Program</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>ControlSpawn</AssemblyName>
    <AssemblyTitle>Control Spawn</AssemblyTitle>
    <RootNamespace>ControlSpawn.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ControlSpawn.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ControlSpawn.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlSpawn.Core\ControlSpawn.Core.csproj" />
    <ProjectReference Include="..\ControlSpawn.Lighting\ControlSpawn.Lighting.csproj" />
  </ItemGroup>


  <!-- The WinForms SDK adds global usings that make Application/Color/Timer ambiguous with WPF. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
