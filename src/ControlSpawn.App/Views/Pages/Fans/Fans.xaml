<ResourceDictionary xmlns:vm="clr-namespace:ControlSpawn.App.ViewModels" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="clr-namespace:ControlSpawn.App.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate DataType="{x:Type vm:FansViewModel}">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" HorizontalAlignment="Right">
          <DockPanel HorizontalAlignment="Right" Margin="0,4,0,6">
            <TextBlock Text="All fans" Style="{StaticResource SmallMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <c:SegmentedControl ItemsSource="{Binding AllModes}" SelectedItem="{Binding AllFansMode, Mode=TwoWay}" AutomationProperties.Name="Profile for every fan" />
          </DockPanel>
          <TextBlock Text="{Binding AllFansSummary}" Style="{StaticResource SmallMuted}" TextAlignment="Right" MaxWidth="460" TextWrapping="Wrap" Margin="0,0,0,12" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="FANS" Style="{StaticResource PageEyebrow}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusLine}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <ItemsControl ItemsSource="{Binding Fans}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:SpacedGrid Columns="3" Gap="16"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- A card picks the fan the curve below edits; the pump has no curve, so its card isn't a button. -->
            <Button CommandParameter="{Binding}" Margin="0" Padding="18" Height="196" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                  <Setter Property="Command" Value="{Binding DataContext.SelectFanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                  <Setter Property="ToolTip" Value="Edit this fan's curve"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource PanelGradientBrush}" CornerRadius="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                          </Trigger>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPump}" Value="True">
                      <Setter Property="Command" Value="{x:Null}"/>
                      <Setter Property="ToolTip" Value="The pump always runs at 100%"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <c:StatusChip Grid.Column="1" Text="{Binding ControlLabel}" Level="{Binding ControlLevel}" VerticalAlignment="Top" Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}"/>
                  <!-- This fan's profile: a chip that opens the list, so one fan can differ from the rest. -->
                  <Button Grid.Column="1" VerticalAlignment="Top" c:MenuOnClick.Enabled="True" Cursor="Hand" ToolTip="Profile for this fan" AutomationProperties.Name="{Binding Name, StringFormat={}{0} profile}"
                          Visibility="{Binding ShowStatus, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="#17181D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProfileText}" FontSize="12" FontWeight="SemiBold"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="#A3A6AE" StrokeThickness="1.4" VerticalAlignment="Center" Margin="8,1,0,0"/>
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                      <ContextMenu ItemsSource="{Binding ModeOptions}">
                        <ContextMenu.ItemContainerStyle>
                          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="Header" Value="{Binding Name}"/><Setter Property="Command" Value="{Binding Command}"/></Style>
                        </ContextMenu.ItemContainerStyle>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                  <StackPanel>
                    <c:DeviceNameEditor DeviceId="{Binding Id}" DisplayName="{Binding Name}" Client="{Binding DataContext.Client, RelativeSource={RelativeSource AncestorType=ItemsControl}}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,4,6,0" />
                  </StackPanel>
                </Grid>
                <DockPanel Margin="0,8,0,0">
                  <Grid DockPanel.Dock="Left" Width="92" Height="92" Margin="0,0,12,0">
                    <c:RingGauge Value="{Binding Percent}" ShowValue="False" ><c:RingGauge.Style><Style TargetType="c:RingGauge"><Setter Property="RingColor" Value="#36D6FF"/><Setter Property="SweepAngle" Value="270"/><Style.Triggers><DataTrigger Binding="{Binding IsPump}" Value="True"><Setter Property="RingColor" Value="#3DDC84"/><Setter Property="SweepAngle" Value="360"/></DataTrigger></Style.Triggers></Style></c:RingGauge.Style></c:RingGauge>
                    <c:FanRotor SpinSeconds="{Binding SpinSeconds}" Margin="0" Width="40" Height="40">
                      <c:FanRotor.Style>
                        <Style TargetType="c:FanRotor">
                          <Setter Property="Color" Value="#36D6FF" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPump}" Value="True">
                              <Setter Property="Color" Value="#3DDC84" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </c:FanRotor.Style>
                    </c:FanRotor>
                  </Grid>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RpmText}" Style="{StaticResource Number}" FontSize="32"/><TextBlock Text="rpm" Style="{StaticResource SmallMuted}" VerticalAlignment="Bottom" Margin="6,0,0,4"/></StackPanel>
                    <TextBlock Text="{Binding DutyText}" Style="{StaticResource SmallMuted}" Foreground="#36D6FF" Margin="0,4"/>
                    <c:Sparkline Values="{Binding History}" Height="30" MinHeight="0" ShowGrid="False" Color="#36D6FF"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding EmptyHeaders}" Style="{StaticResource SmallMuted}" Margin="4,8,0,16"/>
      <c:CardGrid>
        <c:GlassCard StaggerIndex="0" Span="8">
          <c:GlassCard.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem StaysOpenOnClick="True"><MenuItem.Header><StackPanel Width="340">            <Expander Header="Minimum speed" Foreground="#A3A6AE" Margin="0,12,0,0">
            <StackPanel Margin="0,8"><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SourceName, Mode=TwoWay}" AutomationProperties.Name="Full temperature source list"/>
              <TextBlock Text="Minimum speed" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4" />
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="60" Text="{Binding MinSpeedText}" TextAlignment="Right" />
                <c:ThickSlider IsEnabled="{Binding IsPumpSelected, Converter={StaticResource InverseBool}}" Minimum="0" Maximum="100" Value="{Binding MinSpeed, Mode=TwoWay}" AutomationProperties.Name="Minimum speed" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel></Expander></StackPanel></MenuItem.Header></MenuItem></ContextMenu></c:GlassCard.ContextMenu>
          <!-- The graph takes whatever height the row gives it, so this card ends level with Smoothing at any window size. -->
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="340"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4" MinHeight="34">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Back to built-in" Style="{StaticResource TextAction}" Command="{Binding ResetProfileCommand}" Visibility="{Binding ShowReset, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Reset profile"/>
                <!-- Only while the curve differs from what the fan runs. -->
                <Border Background="#2A1A14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="16" Padding="14,4" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Unsaved changes" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Discard" Style="{StaticResource TextAction}" Command="{Binding DiscardCommand}" Foreground="#A3A6AE" Margin="0,0,12,0" AutomationProperties.Name="Discard changes"/>
                    <Button Content="{Binding ApplyLabel}" Style="{StaticResource TextAction}" Command="{Binding ApplyCurveCommand}" FontWeight="SemiBold" AutomationProperties.Name="Save curve"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding CurveTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" ToolTip="{Binding CurveHint}"/>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding ProfileSummary}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <c:FanCurveEditor Grid.Row="2" SelectedIndex="{Binding SelectedCurvePoint, Mode=TwoWay}" Points="{Binding Curve}" Reference="{Binding SavedCurve}" NowTemperature="{Binding NowTemp}" NowPercent="{Binding NowPercent}" UsageLow="{Binding UsageLow}" UsageHigh="{Binding UsageHigh}" RpmMap="{Binding SelectedRpmMap}" IsEnabled="{Binding CanEditCurve}" AutomationProperties.Name="Fan curve" />
            <Border Grid.Row="3" Background="#17181D" CornerRadius="12" Padding="12,8" Margin="0,12,0,0" IsEnabled="{Binding CanEditCurve}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Text="Follows" Style="{StaticResource SmallMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <c:SegmentedControl ItemsSource="{Binding PrimarySources}" SelectedItem="{Binding SelectedPrimarySource, Mode=TwoWay}" FontSize="11" AutomationProperties.Name="Temperature source"/>
                </StackPanel>
                <WrapPanel>
                  <TextBlock Text="{Binding PointLabel}" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
                  <Button Content="&#x2212;" FontSize="13" Width="32" MinHeight="32" Padding="0" Command="{Binding NudgePointCommand}" CommandParameter="cooler" ToolTip="5° cooler" AutomationProperties.Name="Point cooler"/>
                  <TextBox Text="{Binding SelectedTemperatureText, UpdateSourceTrigger=LostFocus}" Width="54" MinHeight="32" Margin="4,0" TextAlignment="Center" Padding="6,0" Background="#0D0E12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" AutomationProperties.Name="Point temperature"/>
                  <Button Content="+" FontSize="13" Width="32" MinHeight="32" Padding="0" Command="{Binding NudgePointCommand}" CommandParameter="hotter" ToolTip="5° hotter" AutomationProperties.Name="Point hotter"/>
                  <TextBlock Text="&#x00B0;C" Style="{StaticResource SmallMuted}" VerticalAlignment="Center" Margin="6,0,20,0"/>
                  <Button Content="&#x2212;" FontSize="13" Width="32" MinHeight="32" Padding="0" Command="{Binding NudgePointCommand}" CommandParameter="down" ToolTip="5% slower" AutomationProperties.Name="Point slower"/>
                  <TextBox Text="{Binding SelectedPercentText, UpdateSourceTrigger=LostFocus}" Width="54" MinHeight="32" Margin="4,0" TextAlignment="Center" Padding="6,0" Background="#0D0E12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" AutomationProperties.Name="Point speed"/>
                  <Button Content="+" FontSize="13" Width="32" MinHeight="32" Padding="0" Command="{Binding NudgePointCommand}" CommandParameter="up" ToolTip="5% faster" AutomationProperties.Name="Point faster"/>
                  <TextBlock Text="%" Style="{StaticResource SmallMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </WrapPanel>
              </DockPanel>
            </Border>
            <DockPanel Grid.Row="4" Margin="0,10,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding CopyLabel}" Style="{StaticResource TextAction}" Command="{Binding CopyCommand}" IsEnabled="{Binding CanCopy}" Margin="0,0,16,0" ToolTip="Give the other fan this same curve" AutomationProperties.Name="Copy curve to the other fan"/>
                <Button Content="{Binding MeasureLabel}" Style="{StaticResource TextAction}" Command="{Binding MeasureCommand}" IsEnabled="{Binding CanMeasure}" ToolTip="{Binding MeasureHint}" AutomationProperties.Name="Measure fan"/>
              </StackPanel>
              <WrapPanel IsEnabled="{Binding CanEditCurve}">
                <Button Content="Quieter" FontSize="12" Padding="10,0" MinHeight="32" Command="{Binding ShapeCommand}" CommandParameter="quieter" Margin="0,0,6,0" ToolTip="Every point slower, the full-speed end kept"/>
                <Button Content="Cooler" FontSize="12" Padding="10,0" MinHeight="32" Command="{Binding ShapeCommand}" CommandParameter="cooler" Margin="0,0,6,0" ToolTip="Every point faster"/>
                <Button Content="Flatten" FontSize="12" Padding="10,0" MinHeight="32" Command="{Binding ShapeCommand}" CommandParameter="flatten" Margin="0,0,6,0" ToolTip="One steady speed across idle"/>
                <Button Content="Undo" FontSize="12" Padding="10,0" MinHeight="32" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" AutomationProperties.Name="Undo curve change"/>
              </WrapPanel>
            </DockPanel>
            <TextBlock Grid.Row="5" Text="{Binding EditStatus}" Style="{StaticResource SmallMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </Grid>
        </c:GlassCard>
        <c:GlassCard Span="4">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Smoothing" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="How the fan reacts to the CPU's short heat spikes" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <c:SmoothingPreview Grid.Row="2" MaxHeight="300" Averaging="{Binding SmoothAveraging}" Hold="{Binding SmoothHold}" UpPerSecond="{Binding SmoothUp}" DownPerSecond="{Binding SmoothDown}" Margin="0,0,0,12"/>
            <StackPanel Grid.Row="3" IsEnabled="{Binding CanEditCurve}">
              <TextBlock Text="Reacts" Style="{StaticResource SmallMuted}"/>
              <c:SegmentedControl ItemsSource="{Binding Responses}" SelectedItem="{Binding SelectedResponse, Mode=TwoWay}" FontSize="11" Margin="0,6,0,4" AutomationProperties.Name="Fan response"/>
              <TextBlock Text="{Binding ResponseHint}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
              <TextBlock Text="Wait before slowing down" Style="{StaticResource SmallMuted}"/>
              <c:SegmentedControl ItemsSource="{Binding Holds}" SelectedItem="{Binding SelectedHold, Mode=TwoWay}" FontSize="11" Margin="0,6,0,4" AutomationProperties.Name="Fan hold"/>
              <TextBlock Text="{Binding HoldHint}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </c:GlassCard>
        <c:GlassCard Span="12">
          <StackPanel>
            <TextBlock Text="Safety" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SafetyHistory}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding SafetyLines}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#17181D" CornerRadius="12" Padding="14,12" Margin="0,0,10,10">
                    <DockPanel>
                      <c:StatusChip DockPanel.Dock="Right" Text="{Binding Reading}" Level="{Binding Level}" VerticalAlignment="Center"/>
                      <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:GlassCard>
      </c:CardGrid>
      <TextBlock Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Text="{Binding LastError}" Style="{StaticResource Muted}" TextWrapping="Wrap" Foreground="#FF8A8A" Margin="0,12" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
